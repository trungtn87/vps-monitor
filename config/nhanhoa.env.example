# ==============================================================================
# VPS Monitor V1 — Nhân Hòa (AutoTrade) Production Environment Configuration
# Location: /opt/vps-monitor/.env
# Permissions: chmod 600 /opt/vps-monitor/.env (chown vpsmon:vpsmon)
# ==============================================================================

NODE_ENV=production

# Server Identification
SERVER_ID=nhanhoa
SERVER_NAME=Nhân Hòa (AutoTrade)
HOST=0.0.0.0
PORT=5050
DB_PATH=/opt/vps-monitor/data/monitor.db

# Transport Security (Finding 2)
# Cross-node traffic over public internet must use TLS / HTTPS or WireGuard private tunnel.
# Provide certificate paths for native HTTPS, or terminate TLS via Nginx / Caddy reverse proxy.
TLS_CERT_PATH=/etc/letsencrypt/live/nhanhoa.yourdomain.com/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/nhanhoa.yourdomain.com/privkey.pem
REQUIRE_TLS=true

# Peer Configuration (pointing to VinaHost VPS over HTTPS or WireGuard private IP)
PEER_SERVER_ID=vinahost
PEER_SERVER_NAME=VinaHost (11Ship)
PEER_URL=https://vinahost.yourdomain.com:5050

# Shared Secret for Cross-VPS HMAC-SHA256 Heartbeat Authentication (Finding 1)
# MUST match VinaHost, randomly generated, and at least 32 characters long!
# Production fails to start if secret is weak or default.
HEARTBEAT_SECRET=replace_with_strong_random_secret_at_least_32_characters_long

# Heartbeat Interval and Disconnect Thresholds (Seconds)
HEARTBEAT_INTERVAL_SEC=60
DISCONNECT_THRESHOLD_SEC=180
STARTUP_GRACE_SEC=180

# Local App Service Health Probe (AutoTrade Bot)
APP_SERVICE_ID=autotrade
APP_SERVICE_NAME=AutoTrade BingX Bot
APP_HEALTH_URL=http://127.0.0.1:3000/healthz

# VPS Expiry Date (YYYY-MM-DD)
EXPIRY_DATE=2026-11-30
PEER_EXPIRY_DATE=2026-12-31

# Web Dashboard Authentication (Fail-Closed: either pass or token required)
DASHBOARD_USER=admin
DASHBOARD_PASS=change_me_to_strong_random_password
API_TOKEN=generate_random_secure_token_min_32_chars

# Discord Integration (Alerts & Bot)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_APP_ID=your_discord_application_id
DISCORD_CHANNEL_ID=your_discord_channel_id_for_alerts
DISCORD_PUBLIC_KEY=your_discord_application_public_key_hex

# Discord Security & Privacy Allowlists (Comma-separated IDs) (Finding 9)
DISCORD_ALLOWED_USER_IDS=123456789012345678
DISCORD_ALLOWED_GUILD_IDS=112233445566778899

# Alert Thresholds (Percentage)
CPU_THRESHOLD_PCT=85
RAM_THRESHOLD_PCT=85
DISK_THRESHOLD_PCT=85
CONSECUTIVE_THRESHOLD_COUNT=3

# Data Retention (Days)
RETENTION_DAYS=30
