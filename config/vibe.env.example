# VPS Monitor Vibe Hosting — Supabase PostgreSQL separate project.
# Current implementation uses Postgres, not SQLite.
# Set secrets in Vibe Hosting Environment; never in Git.
# Nhân Hòa Vibe Hosting — set values through the deployment environment UI.
# This is a TEMPLATE only. Never commit real credentials.
NODE_ENV=production
VIBE_HOSTING=true
TRUSTED_PLATFORM_PROXY=true
# Public GET-only Dashboard; heartbeat still requires signed HMAC.
PUBLIC_DASHBOARD=true
SERVER_ID=nhanhoa
SERVER_NAME=Nhan Hoa (AutoTrade - Vibe container)
HOST=0.0.0.0
PORT=3000
REQUIRE_TLS=false
# Dedicated PostgreSQL 17 only; no SQLite and no AutoTrade database.
DB_BACKEND=supabase_postgres
DATABASE_URL=
PEER_SERVER_ID=vinahost
PEER_SERVER_NAME=VinaHost (11Ship)
PEER_METRIC_SCOPE=HOST
PEER_URL=
HEARTBEAT_SECRET=
# Optional account-level Nhân Hòa CPU/RAM/Disk API. Only enable after
# confirming the full Request URL and approved non-browser API credentials.
# Never copy DevTools cookie, session or Authorization headers here.
VIBE_QUOTA_URL=
VIBE_QUOTA_ACCESS_TOKEN=
VIBE_QUOTA_USER_ID=81
# Dashboard is public read-only (GET), heartbeat still HMAC-authenticated.

APP_SERVICE_ID=autotrade
APP_SERVICE_NAME=AutoTrade (Vibe)
# Public HTTPS health URL of EXISTING AutoTrade deployment, not localhost.
APP_HEALTH_URL=
HEARTBEAT_INTERVAL_SEC=60
DISCONNECT_THRESHOLD_SEC=180
# Set to 180 after both nodes are connected and configured.
STARTUP_GRACE_SEC=1800
EXPIRY_DATE=
PEER_EXPIRY_DATE=
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_CHANNEL_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_GUILD_IDS=
CPU_THRESHOLD_PCT=85
RAM_THRESHOLD_PCT=85
DISK_THRESHOLD_PCT=85
CONSECUTIVE_THRESHOLD_COUNT=3
RETENTION_DAYS=30
