# IMPORTANT: TARGET DATABASE IS SEPARATE SUPABASE POSTGRESQL.
# NOT DEPLOY-READY: current runtime still uses SQLite; PostgreSQL adapter pending.
# Do not publish this branch on Vibe until PR #2 DB migration is complete.
# Supabase DATABASE_URL must be stored in Vibe server Environment, never Git.
# DATABASE_URL=postgresql://<dedicated-monitor-project-connection>
# DB_BACKEND=supabase_postgres
# Nhân Hòa Vibe Hosting — set values through the deployment environment UI.
# This is a TEMPLATE only. Never commit real credentials.
NODE_ENV=production
VIBE_HOSTING=true
TRUSTED_PLATFORM_PROXY=true
# Public GET-only Dashboard; heartbeat still requires signed HMAC.
PUBLIC_DASHBOARD=true
SERVER_ID=nhanhoa
SERVER_NAME=Nhan Hoa (AutoTrade - Vibe container)
HOST=0.0.0.0
PORT=3000
REQUIRE_TLS=false
# The previous local SQLite DB_PATH is obsolete for the target architecture.
# Monitoring data must not use the existing FINAL14-Autotrade project.
PEER_SERVER_ID=vinahost
PEER_SERVER_NAME=VinaHost (11Ship)
PEER_METRIC_SCOPE=HOST
PEER_URL=
HEARTBEAT_SECRET=
# No dashboard password required with PUBLIC_DASHBOARD=true.
# DASHBOARD_USER=admin
# DASHBOARD_PASS=
# API_TOKEN=
APP_SERVICE_ID=autotrade
APP_SERVICE_NAME=AutoTrade (Vibe)
# Public HTTPS health URL of EXISTING AutoTrade deployment, not localhost.
APP_HEALTH_URL=
HEARTBEAT_INTERVAL_SEC=60
DISCONNECT_THRESHOLD_SEC=180
# Set to 180 after both nodes are connected and configured.
STARTUP_GRACE_SEC=1800
EXPIRY_DATE=
PEER_EXPIRY_DATE=
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_CHANNEL_ID=
DISCORD_PUBLIC_KEY=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_GUILD_IDS=
CPU_THRESHOLD_PCT=85
RAM_THRESHOLD_PCT=85
DISK_THRESHOLD_PCT=85
CONSECUTIVE_THRESHOLD_COUNT=3
RETENTION_DAYS=30
