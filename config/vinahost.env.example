# ==============================================================================
# VPS Monitor V1 — VinaHost (11Ship) Production Environment Configuration
# Location: /opt/vps-monitor/.env
# Permissions: chmod 600 /opt/vps-monitor/.env (chown vpsmon:vpsmon)
# ==============================================================================

NODE_ENV=production

# Server Identification
SERVER_ID=vinahost
SERVER_NAME=VinaHost (11Ship)

# Host Binding:
# - Option A (Nginx Reverse Proxy Default): BIND TO 127.0.0.1 ONLY! Never expose unencrypted HTTP to 0.0.0.0.
# - Option B (Native HTTPS with certs): Set HOST=0.0.0.0 and REQUIRE_TLS=true.
# - Option C (WireGuard Private VPN): Set HOST=10.8.0.1 and REQUIRE_TLS=false.
HOST=127.0.0.1
PORT=5050
DB_PATH=/opt/vps-monitor/data/monitor.db

# Transport Security (Review Round 3)
# Option A (Recommended Default): Terminate TLS via Nginx reverse proxy (see ops/nginx/vps-monitor.conf).
#   Node.js binds to 127.0.0.1:5050. Set REQUIRE_TLS=false.
#   Production fails closed if HOST=0.0.0.0 with REQUIRE_TLS=false to prevent unencrypted public exposure.
TLS_CERT_PATH=
TLS_KEY_PATH=
REQUIRE_TLS=false

# Option B (Alternative: Direct Native Node.js HTTPS directly on public port):
#   Set HOST=0.0.0.0, REQUIRE_TLS=true, and deploy certs to /etc/vps-monitor/certs/ (vpsmon:vpsmon 0600)
# TLS_CERT_PATH=/etc/vps-monitor/certs/fullchain.pem
# TLS_KEY_PATH=/etc/vps-monitor/certs/privkey.pem
# REQUIRE_TLS=true

# Peer Configuration (pointing to Nhan Hoa VPS over HTTPS or WireGuard private IP)
PEER_SERVER_ID=nhanhoa
PEER_SERVER_NAME=Nhân Hòa (AutoTrade)
PEER_URL=https://nhanhoa.yourdomain.com:5050

# Shared Secret for Cross-VPS HMAC-SHA256 Heartbeat Authentication (Finding 1)
# MUST be unique, randomly generated, and at least 32 characters long!
# Production fails to start if secret is weak or default.
HEARTBEAT_SECRET=replace_with_strong_random_secret_at_least_32_characters_long

# Heartbeat Interval and Disconnect Thresholds (Seconds)
HEARTBEAT_INTERVAL_SEC=60
DISCONNECT_THRESHOLD_SEC=180
STARTUP_GRACE_SEC=180

# Local App Service Health Probe (11Ship Backend)
APP_SERVICE_ID=11ship
APP_SERVICE_NAME=11Ship Production Backend
APP_HEALTH_URL=http://127.0.0.1:8000/healthz

# VPS Expiry Date (YYYY-MM-DD)
EXPIRY_DATE=2026-12-31
PEER_EXPIRY_DATE=2026-11-30

# Web Dashboard Authentication (Fail-Closed: either pass or token required)
DASHBOARD_USER=admin
DASHBOARD_PASS=change_me_to_strong_random_password
API_TOKEN=generate_random_secure_token_min_32_chars

# Discord Integration (Alerts & Bot)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_APP_ID=your_discord_application_id
DISCORD_CHANNEL_ID=your_discord_channel_id_for_alerts
DISCORD_PUBLIC_KEY=your_discord_application_public_key_hex

# Discord Security & Privacy Allowlists (Comma-separated IDs) (Finding 9)
DISCORD_ALLOWED_USER_IDS=123456789012345678
DISCORD_ALLOWED_GUILD_IDS=112233445566778899

# Alert Thresholds (Percentage)
CPU_THRESHOLD_PCT=85
RAM_THRESHOLD_PCT=85
DISK_THRESHOLD_PCT=85
CONSECUTIVE_THRESHOLD_COUNT=3

# Data Retention (Days)
RETENTION_DAYS=30
